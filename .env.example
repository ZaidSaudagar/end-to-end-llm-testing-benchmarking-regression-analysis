APP_NAME="End-to-End LLM Testing, Benchmarking and Regression Analysis"
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./app.db

# Provider Credentials (Free Tiers)
# 1. Groq Cloud (Free high-speed inference - get at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL_ID=qwen/qwen3.8-27b

# 2. Google Gemini (Free tier - get at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash

# 3. KiraAI MiniMax endpoint
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://kiraai.vn/api/v1
MINIMAX_MODEL_ID=kira-3.5-flash

# Rubric LLM Judge Configuration
JUDGE_ENABLED=false
JUDGE_PROVIDER=minimax
JUDGE_MODEL_ID=kira-3.5-flash

# Embeddings Model for Semantic Similarity
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
