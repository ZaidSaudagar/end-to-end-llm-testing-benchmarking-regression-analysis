# Copy this file to .env and replace placeholders with your own local values.
APP_NAME="End-to-End LLM Testing, Benchmarking and Regression Analysis"
ENVIRONMENT="development"
DEBUG="true"
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_MODEL_ID="gemini-3.8-flash"
OPENROUTER_MODEL_ID="openai/gpt-4o-mini"
PROVIDER_TIMEOUT_SECONDS="30"
PROVIDER_MAX_ATTEMPTS="3"
PROVIDER_MAX_RETRY_DELAY_SECONDS="2"
JUDGE_ENABLED="false"
JUDGE_PROVIDER="openrouter"
JUDGE_MODEL_ID="openai/gpt-4o-mini"
JUDGE_MAX_RESPONSE_ATTEMPTS="2"
JUDGE_REPETITIONS="1"
DATABASE_URL="sqlite:///./app.db"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
STREAMLIT_PORT="8501"
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"
EMBEDDING_MODEL_ID="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_MODEL_REVISION="1110a243fdf4706b3f48f1d95db1a4f5529b4d41"
