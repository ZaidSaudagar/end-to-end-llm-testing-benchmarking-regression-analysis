{
  "dataset_name": "EvalForge Structured Output Tests",
  "dataset_version": "1.0.0",
  "description": "Owner-authored starter cases for validating JSON structure and required fields. These are project-specific test cases, not an external standardized benchmark.",
  "cases": [
    {
      "test_case_id": "STR-001",
      "task_category": "structured_output",
      "input_prompt": "Extract a person's name and age from: 'Maya is 28 years old.'",
      "expected_output": {
        "name": "Maya",
        "age": 28
      },
      "expected_output_schema": {
        "type": "object",
        "required": [
          "name",
          "age"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "age": {
            "type": "integer"
          }
        }
      },
      "evaluation_method": "json_schema_validation",
      "difficulty": "easy",
      "dataset_version": "1.0.0",
      "tags": [
        "json",
        "schema_validation"
      ]
    },
    {
