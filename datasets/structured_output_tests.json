      "test_case_id": "STR-007",
      "task_category": "structured_output",
      "input_prompt": "Extract the meeting date 2026-11-03 and time 14:30.",
      "expected_output": {
        "date": "2026-11-03",
        "time": "14:30"
      },
      "expected_output_schema": {
        "type": "object",
        "required": [
          "date",
          "time"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      },
      "evaluation_method": "json_schema_validation",
      "difficulty": "easy",
      "dataset_version": "1.0.0",
